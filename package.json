{
  "name": "@1hive/celeste",
  "version": "0.1.7",
  "description": "Celeste Oracle fork with provider-neutral identity registry",
  "author": "1Hive",
  "license": "GPL-3.0",
  "files": [
    "/abi",
    "/artifacts",
    "/contracts",
    "/test"
  ],
  "scripts": {
    "compile": "buidler compile",
    "test": "yarn compile && buidler test test/honey-v2-identity-registry.js test/registry/*.js test/court/controller/*.js test/subscriptions/*.js test/feesUpdater/*.js",
    "test:gas": "buidler test test/court/court-gas.js",
    "test:controller": "buidler test test/court/controller/*",
    "test:subscriptions": "buidler test test/subscriptions/*",
    "test:disputes": "buidler test test/disputes/*",
    "test:feesupdater": "buidler test test/feesUpdater/*",
    "test:registry": "buidler test test/registry/*",
    "test:voting": "buidler test test/voting/*",
    "test:full:legacy": "buidler test",
    "deploy:identity-fork": "buidler run scripts/deploy-honey-v2-celeste.js"
  },
  "dependencies": {},
  "devDependencies": {
    "@aragon/test-helpers": "^2.1.0",
    "@aragon/truffle-config-v5": "^1.0.0",
    "@aragon/contract-helpers-test": "^0.1.0-rc.2",
    "@nomiclabs/buidler": "^1.3.0",
    "@nomiclabs/buidler-etherscan": "^1.3.0",
    "@nomiclabs/buidler-truffle5": "^1.3.0",
    "@nomiclabs/buidler-web3": "^1.3.0",
    "buidler-abi-exporter": "^1.0.1",
    "eth-ens-namehash": "^2.0.8",
    "ethers": "^5.0.13"
  }
}
